# .env.example — copier en .env et compléter avant `docker compose up -d`
# (le .env original a été corrompu lors du plantage disque du 26/08/2026 — voir README)

# ── MongoDB / Elasticsearch (utilisés par api, spark-app, streamlit-dashboard) ──
MONGO_URI=mongodb://mongodb:27017
MONGO_DB=disinformation_db
ES_HOST=http://elasticsearch:9200

# ── Kafka (producer + spark-app) ────────────────────────────────
KAFKA_BROKER=kafka:29092

# ── Grafana ──────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_before_deploy

# ── Kaggle API (téléchargement du dataset ISOT — scripts/download_datasets.sh) ──
# Créer un token sur kaggle.com > Account > API > Create New Token,
# puis soit placer kaggle.json dans ~/.kaggle/, soit renseigner ici :
KAGGLE_USERNAME=
KAGGLE_KEY=

# ── Modèle (spark-app/src/nlp_classifier.py, api/src/routers/web_search.py) ──
MODEL_PRETRAINED_PATH=/app/models/pretrained
MODEL_ONNX_PATH=/app/models/onnx/model_quantized.onnx
MODEL_CHECKPOINT_PATH=/app/models/checkpoints
ONNX_MODEL_DIR=/app/models/onnx

# ── Online learning (spark-app/src/nlp_classifier.py, online_trainer.py) ─
ONLINE_LR_BASE=1e-5
ONLINE_LR_DRIFT=5e-5
RESERVOIR_BUFFER_SIZE=5000
ONLINE_TRAIN_EVERY_N=5
SYNC_ONNX_EVERY=100

# ── Tri-détecteur de drift (spark-app/src/drift_monitor.py) ──────
ADWIN_DELTA=0.002
KSWIN_WINDOW_SIZE=100
KSWIN_ALPHA=0.005
PH_DELTA=0.005
PH_THRESHOLD=50.0
DRIFT_COMPOSITE_THRESHOLD=0.4
DRIFT_CONFIRMED_THRESHOLD=0.8
DRIFT_SIGNAL_HOLD_MESSAGES=100
# 4e canal : ADWIN sur l'entropie H(p_fake), cf. reports/EXPERIENCES_2026-08-29.md
# (une campagne de fake hors-distribution peut ne déplacer que faiblement la
# moyenne de p_fake tout en effondrant la confiance du modèle). true = actif.
DRIFT_ENTROPY_CHANNEL=true
ENTROPY_ADWIN_DELTA=0.002

# ── Topics Kafka + Spark (spark-app/src/spark_streaming.py) ──────
KAFKA_TOPIC_RAW=raw-news-stream
KAFKA_TOPIC_DRIFT=drift-alerts
SPARK_MICRO_BATCH_INTERVAL=5 seconds
SPARK_CHECKPOINT_DIR=/tmp/spark-checkpoints
SPARK_DRIVER_MEMORY=1200m

# ── Producer RSS/GDELT (producer/src/kafka_producer.py) ──────────
RSS_SCRAPE_INTERVAL_SEC=60
RSS_DEDUP_TTL_SEC=7200
GDELT_QUERY_INTERVAL_SEC=900

# ── API (utilisée par streamlit-dashboard, page Recherche web) ──
API_BASE=http://api:8000

# ── Streamlit (mode démonstration hors docker-compose, ex: Streamlit Cloud) ──
IS_CLOUD=0

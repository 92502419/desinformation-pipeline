              "selector": "fake_rate",
              "text": "Taux de fake",
              "type": "number"
            }
          ]
        }
      ],
      "description": "Même indicateur que la jauge « Taux de fake » de Streamlit (GET /api/v1/stats, fenêtre des 100 derniers articles traités, simulations incluses) : monte pendant une injection de drift, retombe dès la récupération. Seuils 40 % / 70 %."
    },
    {
      "id": 2,
      "title": "P2 — Flux d'articles traités par minute (réel vs fake)",
      "type": "timeseries",
      "gridPos": {
        "x": 6,
        "y": 10,
        "w": 18,
        "h": 8
      },
      "datasource": {
        "type": "elasticsearch",
        "uid": "es-articles"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Réel"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Fake"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "query": "is_fake:0",
          "metrics": [
            {
              "type": "count",
              "id": "1"
            }
          ],
          "bucketAggs": [
            {
              "type": "date_histogram",
              "field": "processed_at",
              "id": "2",
              "settings": {
                "interval": "1m"
              }
            }
          ],
          "timeField": "processed_at",
          "alias": "Réel"
        },
        {
          "refId": "B",
          "query": "is_fake:1",
          "metrics": [
            {
              "type": "count",
              "id": "1"
            }
          ],
          "bucketAggs": [
            {
              "type": "date_histogram",
              "field": "processed_at",
              "id": "2",
              "settings": {
                "interval": "1m"
              }
            }
          ],
          "timeField": "processed_at",
          "alias": "Fake"
        }
      ],
      "description": "Volume d'articles classés par Spark chaque minute, ventilé par verdict. En flux RSS naturel le débit est faible (quelques articles toutes les 2-4 min) : les barres sont espacées, c'est normal."
    },
    {
      "id": 8,
      "title": "P8 — Taux de fake glissant (moyenne par 5 min)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "elasticsearch",
        "uid": "es-articles"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "spanNulls": true,
            "showPoints": "always",
            "pointSize": 5,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.4
              },
              {
                "color": "red",
                "value": 0.7
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "query": "*",
          "metrics": [
            {
              "type": "avg",
              "id": "1",
              "field": "is_fake"
            }
          ],
          "bucketAggs": [
            {
              "type": "date_histogram",
              "field": "processed_at",
              "id": "2",
              "settings": {
                "interval": "5m",
                "min_doc_count": "1"
              }
            }
          ],
          "timeField": "processed_at",
          "alias": "Taux de fake"
        }
      ],
      "description": "Moyenne de is_fake par fenêtre de 5 minutes : c'est la courbe qui montre le cycle complet normal → injection de drift (hausse) → récupération (retour au niveau de base)."
    },

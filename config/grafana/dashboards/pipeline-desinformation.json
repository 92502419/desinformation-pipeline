  "title": "Pipeline Désinformation — Temps réel",
  "tags": [
    "desinformation",
    "kafka",
    "spark",
    "concept-drift"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 5,
  "refresh": "10s",
